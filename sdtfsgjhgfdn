-- ══════════════════════════════════════════════════════════════════════════════
--  НАСТРОЙКИ
-- ══════════════════════════════════════════════════════════════════════════════
local BULLET_SPEED  = 300          -- скорость пули (studs/s)
local RETRY_COUNT   = 2            -- количество повторных выстрелов
local RETRY_DELAY   = 0.10         -- задержка между повторами (сек)
local GRAVITY       = workspace.Gravity  -- ~196.2 studs/s²
local ITERS         = 5            -- итерации уточнения tFlight

-- ══════════════════════════════════════════════════════════════════════════════
--  VELOCITY TRACKER  (кольцевой буфер позиций → взвешенная скорость)
-- ══════════════════════════════════════════════════════════════════════════════
local HISTORY_SIZE  = 8
local GROUND_THRESH = 0.12         -- m/s; ниже — считаем «на земле» по Y

local trackerData = {}

local function getTracker(userId)
	if not trackerData[userId] then
		trackerData[userId] = {
			samples    = {},
			velSmooth  = Vector3.zero,
			isAirborne = false,
			jumpVelY   = 0,
			jumpTime   = 0,
		}
	end
	return trackerData[userId]
end

RunService.Heartbeat:Connect(function()
	local now = tick()
	for _, p in ipairs(Players:GetPlayers()) do
		if p == player then continue end
		local char = p.Character
		if not char then continue end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end

		local td      = getTracker(p.UserId)
		local samples = td.samples
		local curPos  = hrp.Position

		table.insert(samples, { t = now, pos = curPos })
		while #samples > HISTORY_SIZE do table.remove(samples, 1) end

		if #samples < 3 then continue end

		-- взвешенная скорость из буфера
		local sumVel, sumW = Vector3.zero, 0
		for i = 2, #samples do
			local dt = samples[i].t - samples[i-1].t
			if dt > 1e-5 then
				local v = (samples[i].pos - samples[i-1].pos) / dt
				sumVel = sumVel + v * dt
				sumW   = sumW + dt
			end
		end
		if sumW > 1e-5 then
			td.velSmooth = sumVel / sumW
		end

		-- детектор прыжка по двум последним сэмплам
		local last2dt = samples[#samples].t - samples[#samples-1].t
		local velYraw = 0
		if last2dt > 1e-5 then
			velYraw = (samples[#samples].pos.Y - samples[#samples-1].pos.Y) / last2dt
		end

		if not td.isAirborne then
			if velYraw > 5 then
				td.isAirborne = true
				td.jumpVelY   = velYraw
				td.jumpTime   = now
			end
		else
			local hum     = char:FindFirstChild("Humanoid")
			local onGround = hum and (hum.FloorMaterial ~= Enum.Material.Air)
			if onGround or math.abs(velYraw) < GROUND_THRESH then
				td.isAirborne = false
				td.jumpVelY   = 0
				td.jumpTime   = 0
			end
		end
	end
end)

-- ══════════════════════════════════════════════════════════════════════════════
--  ПОИСК РОЛЕЙ
-- ══════════════════════════════════════════════════════════════════════════════
local function hasTool(p, name)
	if p.Backpack:FindFirstChild(name) then return true end
	if p.Character and p.Character:FindFirstChild(name) then return true end
	return false
end

local function findMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and hasTool(p, "Knife") then return p end
	end
	return nil
end

local function findSheriff()
	for _, p in ipairs(Players:GetPlayers()) do
		if hasTool(p, "Gun") then return p end
	end
	return nil
end

local function findNearestPlayer()
	local nearest, best = nil, math.huge
	local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (myHRP.Position - hrp.Position).Magnitude
				if d < best then best = d; nearest = p end
			end
		end
	end
	return nearest
end

