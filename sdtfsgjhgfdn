--// Shoot Murderer with Prediction (Standalone)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local predX, predY, predZ = 0, 0, 0
local shootOffset = 2.8

local function findMurderer()
	for _, i in ipairs(Players:GetPlayers()) do
		if i.Backpack:FindFirstChild("Knife") then return i end
	end
	for _, i in ipairs(Players:GetPlayers()) do
		if not i.Character then continue end
		if i.Character:FindFirstChild("Knife") then return i end
	end
	return nil
end

local function findSheriff()
	for _, i in ipairs(Players:GetPlayers()) do
		if i.Backpack:FindFirstChild("Gun") then return i end
	end
	for _, i in ipairs(Players:GetPlayers()) do
		if not i.Character then continue end
		if i.Character:FindFirstChild("Gun") then return i end
	end
	return nil
end

local function findNearestPlayer()
	local nearestPlayer = nil
	local shortestDistance = math.huge
	for _, playerIter in ipairs(Players:GetPlayers()) do
		if playerIter ~= player and playerIter.Character then
			local localRootPart = player.Character:FindFirstChild("HumanoidRootPart")
			local otherRootPart = playerIter.Character:FindFirstChild("HumanoidRootPart")
			if localRootPart and otherRootPart then
				local distance = (localRootPart.Position - otherRootPart.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					nearestPlayer = playerIter
				end
			end
		end
	end
	return nearestPlayer
end

local function getPredictedPosition(target)
	local targetChar = target.Character
	if not targetChar then return Vector3.new(0,0,0) end

	local playerHRP = targetChar:FindFirstChild("HumanoidRootPart")
	local humanoid = targetChar:FindFirstChild("Humanoid")
	if not playerHRP or not humanoid then return Vector3.new(0,0,0) end

	local pos = playerHRP.Position
	local velocity = playerHRP.AssemblyLinearVelocity
	local moveDirection = humanoid.MoveDirection

	local ping = 0.1
	local timeStep = (shootOffset / 15) + ping

	local predictedPosition = pos + (velocity * timeStep) + (moveDirection * shootOffset)

	if velocity.Y > 1 then
		predictedPosition = predictedPosition + Vector3.new(0, velocity.Y * timeStep * 1.2, 0)
	elseif velocity.Y < -1 then
		predictedPosition = predictedPosition + Vector3.new(0, velocity.Y * timeStep, 0)
	end

	predictedPosition = predictedPosition + Vector3.new(predX, predY, predZ)

	return predictedPosition
end

