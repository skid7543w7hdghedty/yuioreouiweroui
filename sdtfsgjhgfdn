-- Drag
local dragging = false
local dragStart = nil
local startPos = nil
local hasDragged = false
local dragInputObject = nil
local DRAG_THRESHOLD = 6

local function startDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        hasDragged = false
        dragStart = input.Position
        dragInputObject = input
        startPos = mainFrame.Position

        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragInputObject = nil
                connection:Disconnect()
            end
        end)
    end
end

mainFrame.InputBegan:Connect(startDrag)
shootButton.InputBegan:Connect(startDrag)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input ~= dragInputObject then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local delta = input.Position - dragStart
    if not hasDragged and delta.Magnitude >= DRAG_THRESHOLD then
        hasDragged = true
    end
    if hasDragged then
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

