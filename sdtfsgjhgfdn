-- Получение пинга локального игрока
local function getPing()
    return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
end

-- Получение пинга другого игрока (приблизительно через его персонажа, если недоступно — берём свой)
local function getTargetPing(targetPlayer)
    -- Roblox не даёт прямой пинг других игроков, используем свой как базу
    -- Общая задержка = (наш пинг + пинг цели) / 2 — стандартная формула предсказания
    local myPing = getPing()
    -- Приблизительно: чужой пинг ≈ наш пинг (консервативно), можно масштабировать
    return myPing
end

-- Предсказание позиции цели с учётом пинга
local function predictPosition(character, targetPlayer)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local myPing = getPing()
    local targetPing = getTargetPing(targetPlayer)
    -- Суммарная сетевая задержка в секундах
    local totalLatency = (myPing + targetPing) / 1000 / 2

    -- Скорость цели (AssemblyLinearVelocity — актуальный API)
    local velocity = rootPart.AssemblyLinearVelocity

    -- Дополнительный буфер предсказания (учитываем рендер-задержку ~1 кадр)
    local renderDelta = 1 / 60

    local totalTime = totalLatency + renderDelta

    -- Предсказанная позиция = текущая позиция + скорость * время
    local predicted = rootPart.Position + velocity * totalTime

    return predicted
end

-- Предсказание позиции торса (смещение от HumanoidRootPart к торсу)
local function predictTorsoPosition(character, targetPlayer)
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not torso then return torso and torso.Position or nil end

    local myPing = getPing()
    local targetPing = getTargetPing(targetPlayer)
    local totalLatency = (myPing + targetPing) / 1000 / 2
    local renderDelta = 1 / 60
    local totalTime = totalLatency + renderDelta

    local velocity = rootPart.AssemblyLinearVelocity

    -- Смещение торса от корня
    local offset = torso.Position - rootPart.Position

    local predictedRoot = rootPart.Position + velocity * totalTime
    return predictedRoot + offset
end

local function findMurderer()
    for _, i in ipairs(Players:GetPlayers()) do
        if i.Backpack:FindFirstChild("Knife") then return i end
    end
    for _, i in ipairs(Players:GetPlayers()) do
        if not i.Character then continue end
        if i.Character:FindFirstChild("Knife") then return i end
    end
    return nil
end

local function findSheriff()
    for _, i in ipairs(Players:GetPlayers()) do
        if i.Backpack:FindFirstChild("Gun") then return i end
    end
    for _, i in ipairs(Players:GetPlayers()) do
        if not i.Character then continue end
        if i.Character:FindFirstChild("Gun") then return i end
    end
    return nil
end

local function findNearestPlayer()
    local nearestPlayer = nil
    local shortestDistance = math.huge
    for _, playerIter in ipairs(Players:GetPlayers()) do
        if playerIter ~= player and playerIter.Character then
            local localRootPart = player.Character:FindFirstChild("HumanoidRootPart")
            local otherRootPart = playerIter.Character:FindFirstChild("HumanoidRootPart")
            if localRootPart and otherRootPart then
                local distance = (localRootPart.Position - otherRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestPlayer = playerIter
                end
            end
        end
    end
    return nearestPlayer
end
-- Создание маленькой красной точки (8x8)
local function createTargetDot()
    if targetDot then targetDot:Destroy() end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TargetDot"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 8, 0, 8)
    billboard.SizeOffset = Vector2.new(0, 0)
    billboard.StudsOffset = Vector3.new(0, 0, 0)
    billboard.MaxDistance = math.huge
    billboard.ClipsDescendants = false

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(1, 0, 1, 0)
    dot.Position = UDim2.new(0, 0, 0, 0)
    dot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    dot.BorderSizePixel = 0
    dot.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot

    targetDot = billboard
    return billboard
end

local function updateTargetDot()
    local murderer = findMurderer()
    if murderer and murderer.Character then
        local torso = murderer.Character:FindFirstChild("Torso")
            or murderer.Character:FindFirstChild("UpperTorso")
        if torso then
            if not targetDot or not targetDot.Parent then
                createTargetDot()
                targetDot.Parent = torso
            elseif targetDot.Parent ~= torso then
                targetDot.Parent = torso
            end
        else
            if targetDot then targetDot:Destroy() targetDot = nil end
        end
    else
        if targetDot then targetDot:Destroy() targetDot = nil end
    end
end

RunService.RenderStepped:Connect(updateTargetDot)

