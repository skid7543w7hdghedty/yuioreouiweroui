local targetDot = nil

local function createTargetDot()
	if targetDot then targetDot:Destroy() end

	local billboard = Instance.new("BillboardGui")
	billboard.Name          = "TargetDot"
	billboard.AlwaysOnTop   = true
	billboard.Size          = UDim2.new(0, 8, 0, 8)
	billboard.SizeOffset    = Vector2.new(0, 0)
	billboard.StudsOffset   = Vector3.new(0, 0, 0)
	billboard.MaxDistance   = math.huge
	billboard.ClipsDescendants = false

	local dot = Instance.new("Frame")
	dot.Size                = UDim2.new(1, 0, 1, 0)
	dot.BackgroundColor3    = Color3.fromRGB(255, 0, 0)
	dot.BorderSizePixel     = 0
	dot.Parent              = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius     = UDim.new(1, 0)
	corner.Parent           = dot

	targetDot = billboard
	return billboard
end

RunService.RenderStepped:Connect(function()
	local murderer = findMurderer()
	if murderer and murderer.Character then
		local torso = murderer.Character:FindFirstChild("Torso")
			or murderer.Character:FindFirstChild("UpperTorso")
		if torso then
			if not targetDot or not targetDot.Parent then
				createTargetDot()
				targetDot.Parent = torso
			elseif targetDot.Parent ~= torso then
				targetDot.Parent = torso
			end
			return
		end
	end
	if targetDot then
		targetDot:Destroy()
		targetDot = nil
	end
end)

-- ══════════════════════════════════════════════════════════════════════════════
--  ФИЗИЧЕСКИЙ ПРЕДИКТОР
--  • Пуля MM2 летит по прямой (без гравитации) — мы не компенсируем падение
--  • Цель симулируем: на земле — только горизонталь; в воздухе — парабола
--  • 5 итераций для сходимости tFlight
-- ══════════════════════════════════════════════════════════════════════════════
local function getPing()
	local ok, v = pcall(function()
		return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	return (ok and type(v) == "number") and (v / 1000) or 0.075
end

local function simulateTarget(pos, hVel, velY, isAirborne, t)
	local newY = isAirborne
		and (pos.Y + velY * t - 0.5 * GRAVITY * t * t)
		or  pos.Y
	return Vector3.new(
		pos.X + hVel.X * t,
		newY,
		pos.Z + hVel.Z * t
	)
end

local function getPredictedPosition(origin, target)
	local char = target.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local ping = getPing()
	local td   = getTracker(target.UserId)

	-- горизонтальная скорость из трекера (fallback → AssemblyLinearVelocity)
	local sv   = td.velSmooth
	local hVel = (sv and sv.Magnitude > 0.05)
		and Vector3.new(sv.X, 0, sv.Z)
		or  (function()
				local r = hrp.AssemblyLinearVelocity
				return Vector3.new(r.X, 0, r.Z)
			end)()

	local pos        = hrp.Position
	local isAirborne = td.isAirborne
	local velY       = 0

	if isAirborne and td.jumpTime > 0 then
		local elapsed = tick() - td.jumpTime
		velY = td.jumpVelY - GRAVITY * elapsed
		if velY < -80 then velY = 0; isAirborne = false end
	end

	-- итерационное уточнение
	local predicted = pos
	for _ = 1, ITERS do
		local dist    = (origin - predicted).Magnitude
		local tFlight = dist / BULLET_SPEED + ping * 0.5
		predicted = simulateTarget(pos, hVel, velY, isAirborne, tFlight)
	end

	return predicted
end

-- ══════════════════════════════════════════════════════════════════════════════
--  ВЫСТРЕЛ СКВОЗЬ СТЕНЫ
--  Origin ставим вплотную к предсказанной точке цели (0.5 studs назад) —
--  это обходит серверный рейкаст и гарантирует попадание даже через стены.
-- ══════════════════════════════════════════════════════════════════════════════
local function equipGun()
	local char = player.Character
	if not char then return false end
	if char:FindFirstChild("Gun") then return true end
	local gun = player.Backpack:FindFirstChild("Gun")
	if not gun then return false end
	local hum = char:FindFirstChild("Humanoid")
	if hum then hum:EquipTool(gun) end
	RunService.Heartbeat:Wait()
	return char:FindFirstChild("Gun") ~= nil
end

local function fireAt(predictedPos)
	local char = player.Character
	if not char then return end
	local hrp  = char:FindFirstChild("HumanoidRootPart")
	local dir  = predictedPos - (hrp and hrp.Position or predictedPos)

	-- origin — на 0.5 studs позади предсказанной точки (со стороны цели)
	-- чтобы пуля не делала нулевой raycast и гарантированно не отсекалась стеной
	local fakeSrc = (dir.Magnitude > 0.01)
		and (predictedPos - dir.Unit * 0.5)
		or  (predictedPos + Vector3.new(0, 0, -0.5))

	pcall(function()
		char:WaitForChild("Gun"):WaitForChild("Shoot"):FireServer(
			CFrame.new(fakeSrc),
			CFrame.new(predictedPos)
		)
	end)
end

local function shootMurderer()
	if findSheriff() ~= player then
		game.StarterGui:SetCore("SendNotification", {
			Title = "Ошибка", Text = "Ты не шериф/герой.", Duration = 2
		})
		return
	end

	local target = findMurderer() or findNearestPlayer()
	if not target then
		game.StarterGui:SetCore("SendNotification", {
			Title = "Ошибка", Text = "Цель не найдена.", Duration = 2
		})
		return
	end

	if not equipGun() then
		game.StarterGui:SetCore("SendNotification", {
			Title = "Ошибка", Text = "Пистолет не найден.", Duration = 2
		})
		return
	end

	for i = 1, RETRY_COUNT do
		local char = player.Character
		if not char then break end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then break end
		if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then break end
		local targetHum = target.Character:FindFirstChild("Humanoid")
		if not targetHum or targetHum.Health <= 0 then break end

		local predicted = getPredictedPosition(hrp.Position, target)
		if not predicted then break end

		fireAt(predicted)
		if i < RETRY_COUNT then task.wait(RETRY_DELAY) end
	end

	game.StarterGui:SetCore("SendNotification", {
		Title   = "Выстрел произведён",
		Text    = string.format("Выпущено %d пуль по предсказанной позиции.", RETRY_COUNT),
		Duration = 1.5
	})
end

